# Backend Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/digital_notice_board
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/digital_notice_board?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/digital_notice_board

# Secret key used for signing JWT tokens (min 32 random characters)
JWT_SECRET=replace-with-a-long-random-secret

# Allowed CORS origin (Vite dev server or frontend domain)
FRONTEND_ORIGIN=http://localhost:5173

# Node environment (development / production)
NODE_ENV=development
